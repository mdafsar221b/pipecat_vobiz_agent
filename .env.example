# Gemini API Configuration
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_API_KEY_FALLBACK=your_fallback_gemini_key_here
GEMINI_API_KEY_3=your_third_gemini_key_here
GEMINI_MODEL=gemini-3.1-flash-live-preview
GEMINI_VOICE=Aoede
GEMINI_LANGUAGE=te-IN

# Vobiz Telephony Configuration
VOBIZ_AUTH_ID=your_vobiz_auth_id
VOBIZ_AUTH_TOKEN=your_vobiz_auth_token
VOBIZ_PHONE_NUMBER=your_vobiz_caller_id_number
FROM_NUMBER=your_vobiz_caller_id_number

# Server & Network Configuration
PORT=8000
PUBLIC_URL=https://your-public-domain-or-tunnel.com

# MongoDB Database Configuration
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=vobiz_agent_db

# Agent Configuration
AGENT_GREETING=నమస్తే అండి! నేను అనన్య స్వర్గసీమ నుంచి మాట్లాడుతున్నాను. మీరు మాకు మిస్డ్ కాల్ చేశారు. మీకు స్వర్గసీమ ప్రాజెక్ట్స్ లో ఇంట్రెస్ట్ ఉందా అండి?
AGENT_SYSTEM_PROMPT="You are Ananya (అనన్య), an outbound AI voice calling agent for Swargaseema, a real-estate plots company..."
ENABLE_END_CALL=true
